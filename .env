# Airflow 공식 docker-compose 가 읽는 환경변수
#
# Linux 에서는 아래 명령으로 본인 UID 를 넣어 준다.
#   echo "AIRFLOW_UID=$(id -u)" > .env
# macOS / Windows(WSL) 는 50000 그대로 두어도 된다.
AIRFLOW_UID=50000

# docker-compose.yaml 이 마운트할 프로젝트 경로
AIRFLOW_PROJ_DIR=.

# Q5 에서 빌드하는 커스텀 이미지 이름
# AIRFLOW_IMAGE_NAME 은 Q5 에서 compose 에 직접 지정합니다

# ── 주의 ─────────────────────────────────────────────────────────────────────
# AWS 액세스 키는 절대 이 파일에 적지 않는다. (공통 규약 C / Q9 조건)
# S3 자격증명은 Airflow UI ▸ Admin ▸ Connections 의 aws_default 에만 등록한다.
